{# Phone CTA, used on every page that offers a way to act. #}
{# A real link with text, never an icon-only button (PROJECT.md §6). #}
{% macro phoneCta(text = 'Anrufen', note = '') %}
<p class="cta">
  <a class="btn btn--primary" href="{{ site.phoneHref }}">
    {{ 'phone' | icon }}{{ text }}
  </a>
</p>
{% if note %}
<p class="cta__note">{{ note }}</p>
{% endif %}
{% endmacro %}
