{# Wordmark. The lightning bolt carries the old blue→red gradient, the text #}
{# inherits currentColor from the link. Inline so it needs no HTTP request. #}
<a class="logo" href="/" aria-label="{{ site.name }} – Startseite">
  <svg class="logo__svg" viewBox="0 0 40 44" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-bolt-gradient" x1="4" y1="40" x2="36" y2="6" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#c33b32"/>
        <stop offset=".5" stop-color="#8a3f8f"/>
        <stop offset="1" stop-color="#1a5fb4"/>
      </linearGradient>
    </defs>
    <path d="M23 2 6 26h10l-3 16 16-24h-9z" fill="url(#logo-bolt-gradient)"/>
  </svg>
  <span class="logo__parts">
    <b>{{ site.name.split('-')[0] }}</b><i>-{{ site.name.split('-')[1] }}</i>
  </span>
</a>
