<footer class="site-footer">
  <div class="wrap footer__grid">
    <div>
      <p><strong>{{ site.name }}</strong></p>
      <address class="fine">{{ site.owner }}, {{ site.title }}<br>{{ site.street }}, {{ site.zip }} {{ site.city }}</address>
    </div>
    <div>
      <p><a href="{{ site.emailHref }}">{{ site.email }}</a></p>
    </div>
  </div>
  <div class="wrap">
    <ul class="legal">
      {% for item in site.legalNav %}
      <li><a href="{{ item.href }}">{{ item.text }}</a></li>
      {% endfor %}
    </ul>
    <p class="fine">
        © {{ site.year }} {{ site.name }} · Keine Tracking-Dienste, keine Cookies.
    </p>
  </div>
</footer>
