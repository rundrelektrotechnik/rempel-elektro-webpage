<footer class="site-footer">
  <div class="wrap footer__top">
    <div class="footer__brand">
      <p class="footer__name">{{ site.name }}</p>
      <p class="footer__tagline">{{ site.tagline }}</p>
    </div>

    <nav class="footer__col" aria-label="Leistungen">
      <p class="footer__title">Leistungen</p>
      <ul class="footer__list">
        {% for service in services %}
        <li><a href="/leistungen/#{{ service.id }}">{{ service.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <div class="footer__col">
      <p class="footer__title">Kontakt</p>
      <address class="footer__address">
        {{ site.owner }}, {{ site.title }}<br>
        {{ site.street }}<br>
        {{ site.zip }} {{ site.city }}
      </address>
      <p class="footer__mail"><a href="{{ site.emailHref }}">{{ site.email }}</a></p>
    </div>
  </div>

  <div class="footer__bar">
    <div class="wrap footer__bar-inner">
      <p class="footer__fine">© {{ site.year }} {{ site.name }} · Keine Cookies, kein Tracking.</p>
      <ul class="footer__legal">
        {% for item in site.legalNav %}
        <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</footer>
