---
layout: layouts/base.njk
title: 'Leistungen im Überblick'
description: 'Planung und Beratung, Kundendienst, Elektroinstallation, Antennenanlagen und Photovoltaik für Michelstadt und den Odenwald. Was jeder Bereich umfasst.'
sitemap: true
---
<section class="hero">
  <div class="wrap">
    <h1>{{ text.servicesPage.title }}</h1>
    <p class="hero__lede">{{ text.servicesPage.lede }}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ site.phoneHref }}">{{ 'phone' | icon }}Anrufen</a>
      <a class="btn btn--secondary" href="/kontakt/">Kontakt</a>
    </div>
  </div>
</section>

{% for service in services %}
<section class="service" id="{{ service.id }}">
  <div class="wrap service__grid">
    <img class="service__img" src="{{ service.image }}" alt="" width="900" height="600" loading="lazy" decoding="async" style="object-position: {{ service.imagePos }}">
    <div class="service__text">
      <h2 class="service__title">{{ service.title }}</h2>
      <p class="service__lede">{{ service.lede }}</p>
      <ul class="checks">
        {% for item in service.items %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endfor %}

<section class="band">
  <div class="wrap">
    <h2>{{ text.servicesPage.closingTitle }}</h2>
    <p>{{ text.servicesPage.closingText }}</p>
    <p class="cta"><a class="btn btn--primary" href="{{ site.phoneHref }}">{{ 'phone' | icon }}Anrufen</a></p>
  </div>
</section>
