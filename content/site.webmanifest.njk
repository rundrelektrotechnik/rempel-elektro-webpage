---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.metaTitle }}",
  "short_name": "{{ site.name }}",
  "description": "Elektrohandwerk in Michelstadt und im Odenwald. Telefon: {{ site.phone }}.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "/",
  "display": "standalone",
  "background_color": "{{ site.themeColor }}",
  "theme_color": "{{ site.themeColor }}",
  "icons": [
    {
      "src": "/assets/favicon/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/assets/favicon/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
